# Copia este archivo como .env.local (desarrollo) y configura las mismas variables en
# Netlify → Site configuration → Environment variables.

# ── Supabase (Dashboard → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://atuzdlzgpvrsrxqdlpzl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# service_role: SOLO servidor (cron de plazos, invitar usuarios, registrar notificaciones). Nunca con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Correo (usar UNO de los dos) ──
RESEND_API_KEY=
SENDGRID_API_KEY=
# Remitente verificado en el proveedor (dominio etinar.com)
EMAIL_FROM=sst@etinar.com

# ── URL pública de la app (enlaces en correos) ──
APP_URL=https://ssoma-etinar.netlify.app

# ── Control automático de plazos ──
# Texto largo aleatorio; lo usa la función programada de Netlify para llamar a /api/cron/plazos
CRON_SECRET=
# Días de anticipación para el aviso "la fecha límite se aproxima"
PLAZO_AVISO_DIAS=2

# ── WhatsApp (fase 2, desactivado) ──
NOTIF_WHATSAPP=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
