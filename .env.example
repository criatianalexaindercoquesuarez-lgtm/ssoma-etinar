# Copia este archivo como .env.local y pon tus valores reales
# Supabase: Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# SendGrid (para notificaciones por correo): sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@etinar.com

# Twilio (para notificaciones por WhatsApp): console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
